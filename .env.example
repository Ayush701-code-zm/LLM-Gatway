# ===========================================================
# SmartRoute AI — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ===========================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
APP_NAME=SmartRoute AI
APP_VERSION=0.1.0

# ── API Server ───────────────────────────────────────────────
API_PORT=3001
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:3001

# ── Frontend ─────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_NAME=SmartRoute AI

# ── Database (Supabase PostgreSQL) ───────────────────────────
# Local dev (Docker Compose): uses smartroute/dev_password
DATABASE_URL=postgresql://smartroute:dev_password@localhost:5432/smartroute?schema=public
DIRECT_URL=postgresql://smartroute:dev_password@localhost:5432/smartroute?schema=public

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-256-bit-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-256-bit-random-secret
JWT_REFRESH_EXPIRES_IN=7d

# ── API Key Encryption ───────────────────────────────────────
API_KEY_ENCRYPTION_SECRET=change-me-32-char-aes-secret-here

# ── LLM Providers ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_GENERATIVE_AI_API_KEY=AIza...
COHERE_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Semantic Cache ────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_CACHE_THRESHOLD=0.92
CACHE_TTL_SECONDS=3600

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ── Celery workers (optional — run separately in production) ──
QUEUE_CONCURRENCY_ANALYTICS=5
QUEUE_CONCURRENCY_HEALTH_CHECKS=2
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Observability ─────────────────────────────────────────────
LOG_LEVEL=info
PROMETHEUS_PORT=9090

# ── Supabase (optional direct client) ────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Backpressure ──────────────────────────────────────────────
MAX_INFLIGHT_REQUESTS=500

# ── Email (SMTP) — team invites & budget alerts ───────────────
# If unset, emails are skipped (logged at debug level).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com
# Set to true in production to block API key creation until email is verified
REQUIRE_EMAIL_VERIFICATION=false

# ── Google OAuth — social login ───────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match OAUTH_REDIRECT_URI exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3001/api/v1/auth/oauth/google/callback

# ── Stripe Billing (optional — leave blank for local dev) ─────
# Dashboard: https://dashboard.stripe.com
# Create Products + recurring Prices, then paste price IDs below.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...
