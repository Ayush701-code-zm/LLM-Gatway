{
  "title": "SmartRoute AI — Overview",
  "uid": "smartroute-overview",
  "version": 1,
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["smartroute", "gateway", "llm"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Total Requests (1h)",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(increase(smartroute_llm_requests_total[1h]))", "legendFormat": "Requests" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } } }
    },
    {
      "id": 2, "type": "stat", "title": "Success Rate",
      "gridPos": { "x": 4, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(rate(smartroute_llm_requests_total{status='success'}[5m])) / sum(rate(smartroute_llm_requests_total[5m])) * 100", "legendFormat": "%" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 95 }, { "color": "green", "value": 99 }] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Cache Hit Rate",
      "gridPos": { "x": 8, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "avg(smartroute_cache_hit_rate) * 100", "legendFormat": "%" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": 0 }, { "color": "green", "value": 50 }] } } }
    },
    {
      "id": 4, "type": "stat", "title": "Total Cost (1h)",
      "gridPos": { "x": 12, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(increase(smartroute_llm_cost_usd_total[1h]))", "legendFormat": "USD" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4 } }
    },
    {
      "id": 5, "type": "stat", "title": "Total Savings (1h)",
      "gridPos": { "x": 16, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "sum(increase(smartroute_llm_savings_usd_total[1h]))", "legendFormat": "USD" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background" },
      "fieldConfig": { "defaults": { "unit": "currencyUSD", "decimals": 4, "color": { "mode": "fixed", "fixedColor": "green" } } }
    },
    {
      "id": 6, "type": "stat", "title": "Avg Latency (p50)",
      "gridPos": { "x": 20, "y": 0, "w": 4, "h": 4 },
      "targets": [{ "expr": "histogram_quantile(0.5, sum(rate(smartroute_llm_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "ms" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 10, "type": "timeseries", "title": "Request Rate by Provider",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "sum(rate(smartroute_llm_requests_total[5m])) by (provider)", "legendFormat": "{{provider}}" }],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 11, "type": "timeseries", "title": "P50 / P95 / P99 Latency",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(smartroute_llm_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(smartroute_llm_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(smartroute_llm_request_duration_seconds_bucket[5m])) by (le)) * 1000", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 20, "type": "timeseries", "title": "Cost vs Savings Over Time",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(smartroute_llm_cost_usd_total[5m]))", "legendFormat": "Actual Cost/s" },
        { "expr": "sum(rate(smartroute_llm_savings_usd_total[5m]))", "legendFormat": "Savings/s" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    },
    {
      "id": 21, "type": "timeseries", "title": "Cache Hits vs Misses",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum(rate(smartroute_cache_hits_total[5m]))", "legendFormat": "Cache Hits" },
        { "expr": "sum(rate(smartroute_cache_misses_total[5m]))", "legendFormat": "Cache Misses" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 30, "type": "timeseries", "title": "HTTP Request Duration (API)",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(smartroute_http_request_duration_seconds_bucket[5m])) by (le, route)) * 1000", "legendFormat": "{{route}} p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    },
    {
      "id": 31, "type": "timeseries", "title": "Provider Availability",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [{ "expr": "smartroute_provider_availability", "legendFormat": "{{provider}}/{{model}}" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "green", "value": 1 }] } } }
    },
    {
      "id": 40, "type": "gauge", "title": "Queue Depths",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 6 },
      "targets": [{ "expr": "smartroute_queue_depth", "legendFormat": "{{queue_name}}" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 41, "type": "timeseries", "title": "Node.js Event Loop Lag",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 6 },
      "targets": [{ "expr": "smartroute_node_nodejs_eventloop_lag_seconds * 1000", "legendFormat": "event loop lag" }],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ]
}
